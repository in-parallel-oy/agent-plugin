{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "IN_PARALLEL_CLIENT=codex node \"${PLUGIN_ROOT}/scripts/context.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "IN_PARALLEL_CLIENT=codex node \"${PLUGIN_ROOT}/scripts/context.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "IN_PARALLEL_CLIENT=codex node \"${PLUGIN_ROOT}/scripts/heartbeat.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__in[-_]parallel__announce_work",
        "hooks": [
          {
            "type": "command",
            "command": "IN_PARALLEL_CLIENT=codex node \"${PLUGIN_ROOT}/scripts/remember-claim.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "IN_PARALLEL_CLIENT=codex node \"${PLUGIN_ROOT}/scripts/heartbeat.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "IN_PARALLEL_CLIENT=codex node \"${PLUGIN_ROOT}/scripts/heartbeat.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "IN_PARALLEL_CLIENT=codex node \"${PLUGIN_ROOT}/scripts/context.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
