{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/context.js\"",
        "timeout": 10
      }
    ],
    "afterMCPExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/remember-claim.js\"",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/context.js\"",
        "timeout": 10,
        "matcher": "^(Shell|Write|Delete|Task|MCP:.*)$"
      }
    ]
  }
}
