{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/reminders.js\"", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__(plugin_in-parallel_in_parallel|in_parallel|in-parallel)__(report_back|get_action_item|get_decision|get_risk|get_open_question|get_observations)$",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/reminders.js\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/reminders.js\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "mcp_tool", "server": "plugin:in-parallel:in_parallel", "tool": "report_back_reminder", "input": { "stop_hook_active": "${stop_hook_active}", "client_session": "${session_id}" }, "timeout": 30 }
        ]
      }
    ]
  }
}
