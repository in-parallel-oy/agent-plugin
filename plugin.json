{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "in-parallel",
  "version": "0.1.1",
  "description": "Read what needs attention, capture findings, and make overlapping work visible in In Parallel.",
  "author": {
    "name": "In Parallel Oy",
    "url": "https://www.in-parallel.ai"
  },
  "homepage": "https://www.in-parallel.ai",
  "repository": "https://github.com/in-parallel-oy/agent-plugin",
  "license": "MIT",
  "keywords": [
    "in-parallel",
    "coordination",
    "work-claims",
    "planning",
    "mcp"
  ],
  "extensions": {
    "ai.in-parallel": {
      "hooks": {
        "claude-code": "./hooks/claude.json",
        "codex": "./hooks/codex.json",
        "cursor": "./hooks/cursor.json"
      }
    }
  }
}
